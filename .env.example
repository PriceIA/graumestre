# Copie este arquivo como .env.local e preencha.
# As duas estão em Supabase > Settings > API.

# URL do projeto Supabase (ex.: https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública do Supabase. Aceita tanto a anon key legada (JWT, eyJ...)
# quanto a publishable key nova (sb_publishable_...).
#
# Esta chave é pública por design e vai no bundle do browser — ela só
# identifica o projeto. Quem protege os dados são as policies de RLS, que
# exigem sessão autenticada (ver 009_rls_authenticated.sql).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
