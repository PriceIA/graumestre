# Copie este arquivo como .env.local e preencha.
# As duas primeiras estão em Supabase > Settings > API.

# URL do projeto Supabase (ex.: https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública do Supabase. Aceita tanto a anon key legada (JWT, eyJ...)
# quanto a publishable key nova (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠ RESERVADA — nenhum código lê esta variável hoje.
# Era a intenção de uma tela de PIN para o professor, que nunca foi
# implementada. Preencher não protege nada. Quando a tela existir, lembre que
# NEXT_PUBLIC_* vai para o bundle do browser: um PIN de verdade precisa ser
# validado no servidor, não aqui.
NEXT_PUBLIC_PROFESSOR_PIN=
